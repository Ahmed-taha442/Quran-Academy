generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
  GUARDIAN
}

enum TrackKind {
  NOOR_BAYAN
  QURAN
}

enum LessonKind {
  VIDEO
  AUDIO
  INTERACTIVE
  LIVE
  PRACTICE
  ASSESSMENT
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NEEDS_REVIEW
}

model User {
  id               String   @id @default(cuid())
  role             UserRole @default(STUDENT)
  email            String   @unique
  displayName      String
  emailVerified    Boolean  @default(false)
  image            String?
  preferredLocale  String   @default("en")
  nativeLanguage   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  accounts         Account[]
  sessions         Session[]
  studentProfile   StudentProfile?
  taughtSessions   LiveSession[]   @relation("TeacherSessions")
  feedbackGiven    TeacherFeedback[]
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model StudentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  teacherId       String?
  guardianId      String?
  proficiency     String
  enrollments     Enrollment[]
  progress        LessonProgress[]
  hifzAssignments HifzAssignment[]
  sessions        LiveSessionStudent[]
  quranActivities QuranStudyActivity[]
}

model QuranStudyActivity {
  id              String         @id @default(cuid())
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  activityType    String
  surahNumber     Int
  fromAyah        Int
  toAyah          Int
  durationSeconds Int            @default(0)
  selfRating      String?
  createdAt       DateTime       @default(now())

  @@index([studentId, createdAt])
  @@index([studentId, activityType, createdAt])
}

model Course {
  id       String    @id @default(cuid())
  slug     String    @unique
  track    TrackKind
  titleKey String
  lessons  Lesson[]
  enrollments Enrollment[]
}

model Lesson {
  id              String         @id @default(cuid())
  courseId        String
  course          Course         @relation(fields: [courseId], references: [id])
  slug            String
  kind            LessonKind
  order           Int
  titleKey        String
  durationMinutes Int
  progress        LessonProgress[]
}

model Enrollment {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  courseId  String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  startedAt DateTime       @default(now())

  @@unique([studentId, courseId])
}

model LessonProgress {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  lessonId  String
  lesson    Lesson         @relation(fields: [lessonId], references: [id])
  status    ProgressStatus @default(NOT_STARTED)
  score     Int?
  updatedAt DateTime       @updatedAt

  @@unique([studentId, lessonId])
}

model HifzAssignment {
  id          String         @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])
  surahNumber Int
  fromAyah    Int
  toAyah      Int
  dueAt       DateTime?
}

model LiveSession {
  id               String               @id @default(cuid())
  teacherId        String
  teacher          User                 @relation("TeacherSessions", fields: [teacherId], references: [id])
  startsAt         DateTime
  durationMinutes  Int
  topic            String
  meetingUrl       String?
  students         LiveSessionStudent[]
}

model LiveSessionStudent {
  sessionId String
  studentId String
  session   LiveSession    @relation(fields: [sessionId], references: [id])
  student   StudentProfile @relation(fields: [studentId], references: [id])

  @@id([sessionId, studentId])
}

model TeacherFeedback {
  id          String   @id @default(cuid())
  teacherId   String
  teacher     User     @relation(fields: [teacherId], references: [id])
  studentId   String
  lessonId    String
  comment     String
  audioNoteUrl String?
  createdAt   DateTime @default(now())
}

model MediaAsset {
  id         String @id @default(cuid())
  kind       String
  url        String
  durationMs Int?
  reciter    String?
  letterId   String?
  ayahRef    String?
}
